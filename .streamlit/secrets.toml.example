# Copy into Streamlit Cloud → App → Settings → Secrets (or .streamlit/secrets.toml locally).
# NEVER commit the real file.

# ---------------- Access ----------------
ADMIN_PASSWORD = "change-me"          # unlocks the Admin tab

# ---------------- Database (MongoDB Atlas, free tier is fine) ----------------
MONGODB_URI = "mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB = "aa_resume_analyzer"

# ---------------- AI ----------------
OPENAI_API_KEY = "sk-..."
LLM_PROVIDER = "openai"            # or "groq" (then set GROQ_API_KEY)

# ---------------- Email (Gmail / Workspace: 2-Step Verification → App password) ----------------
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "hr@analyticsavenue.in"
SMTP_PASSWORD = "xxxx xxxx xxxx xxxx"
FROM_EMAIL = "hr@analyticsavenue.in"

# ---------------- Google Drive (resume folders) ----------------
DRIVE_FOLDER_ID = "1bSH_SI2-PSCpWKqDOO87LHIaK5PeMqMf4deRig7N-0NfoydGgsWfrwJojX-LTsQzKjRDkieP"

